      "id": "4b3e7ed4-b96e-4565-bc6c-bb68eb02916e",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "content": "⚙️ CONFIGURACIÓN DEL AGENTE POR CANAL\n\nConsulta en Supabase la tabla [DRIVE] consulta_sysprompt para obtener las instrucciones configuradas para el canal de Slack correspondiente.\n\nEl prompt recuperado define el comportamiento y el contexto de trabajo del agente para ese canal.",
        "height": 464,
        "color": 2
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -112,
        -416

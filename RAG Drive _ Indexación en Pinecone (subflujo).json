    {
      "parameters": {
        "jsCode": "\nconst unicos = new Map();\n\nfor (const item of $input.all()) {\n  const fileId = item.json.metadata.archivo_id;\n\n  if (!unicos.has(fileId)) {\n    unicos.set(fileId, item);\n  }\n}\n\nreturn Array.from(unicos.values());\n"
